{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push upstream *)",
      "Bash(git push * upstream)",
      "Bash(git push * upstream *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git restore -- .)",
      "Bash(git branch -D *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(credentials.json)",
      "Edit(/data/*.db)",
      "Edit(/data/*.db-*)",
      "Edit(//**/*.lg/**)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * pennant-v*)",
      "Bash(git push *--delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git fetch *--tags*)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Edit(/data/*.json)"
    ]
  }
}
