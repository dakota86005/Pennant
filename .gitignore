# Dependencies (no trailing slash: an agent worktree links node_modules as a
# symlink, which a directory-only pattern does not match)
node_modules

# Build output
dist/
build/main.cjs
build/main.cjs.map
build/preload.cjs
build/value-refit-worker.cjs
build/value-refit-worker.cjs.map
build/calibration-refit-worker.cjs
build/calibration-refit-worker.cjs.map
# The Mac app's server bundle and its pinned Node runtime (npm run build:sidecar, npm run sidecar:node)
build/sidecar/
build/node-runtime/
# The server staged for the Mac app bundle, its production install, the Mac test results and snapshots (macos/)
build/macos-server/
build/macos-server-install/
build/macos-test/
build/macos-snapshots/
build/macos-ci/
# Pennant for Mac's release: Sparkle's pinned tools (fetch-sparkle-tools.sh) and the release build (D-076)
build/sparkle-tools/
build/mac-release/
release/

# Local data — imported league database, rating history, AI caches
data/

# OOTP saves/exports and generated SQLite files, wherever they are placed
*.lg/
saved_games/
import_export/
*.db
*.db-shm
*.db-wal
*.db-journal

# Local configuration — points at YOUR save on YOUR machine
config.json

# Machine-local app state, if accidentally written outside data/
credentials.json
settings.json
# ...except the shared Claude Code project settings; the personal ones stay local
!.claude/settings.json
.claude/settings.local.json
# Agent worktrees created by Claude Code
.claude/worktrees/
last-import.json
port.json
briefing-*.json
storylines-*.json
chat-*.json

# Secrets — provider API keys may live here. NEVER commit these.
.env
.env.*
!.env.example

# Signing credentials and private keys
*.p12
*.pfx
*.pem

# Swift packages' build output and Xcode's per-user state (macos/)
.build/
xcuserdata/
*.profraw

# OS
.DS_Store

# Rights-experiment captures come from a private save
captures/
