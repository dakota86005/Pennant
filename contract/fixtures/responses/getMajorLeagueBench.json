  "title": {
    "display": "Bench & Backups"
  },
  "lede": {
    "text": "What the bench is for, and who can really play where",
    "tone": "neutral",
    "basis": {
      "because": [
        {
          "label": "How to read it",
          "value": "A bench is for something. Three positions need somebody who can really play them (catcher, middle infield, center field); the rest of what a bench does, a bat to send up, a glove for late innings, a runner, flexibility, is shown as jobs that someone does or nobody does. Being able to stand at a position is not being a backup for it: backups are read against the peers who actually play the position. Nothing here is a bench score."
        }
      ],
      "source": {
        "department": "majorLeague",
        "specialist": "Major League Ops' roster review",
        "asOf": null,
        "gameDate": "2040-05-05"
      },
      "unknown": [],
      "wouldChange": [],
      "lean": null,
      "certainty": "policy",
      "called": "A line chosen and stated",
      "stamp": "How Major League Ops reads its roster: stated, not fitted"
    },
    "links": []
  },
  "yardsticks": {
    "text": "Using starting yardsticks for now: this league has not been measured yet",
    "tone": "neutral",
    "basis": {
      "because": [
        {
          "label": "Where the lines come from",
          "value": "The roster review judges each player against yardsticks: what a regular at his job typically looks like, how players his age tend to change, how much the glove counts at his position, how much his recent seasons count, what a hitter's tools say and how much they hold his results back, how much a hitter's own record against left- and right-handers counts, and how long a reliever has to work to count as a long man."
        },
        {
          "label": "Where the lines come from",
          "value": "The line for each job: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "How players age: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "How much the glove counts at each position: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "How much recent seasons count: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "How much a hitter's own split counts: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "What a hitter's tools say, and how much they hold his results back: the starting values, because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "Who counts as a long man: the starting value (a reliever who averages 1.6 or more innings an appearance), because this league has not been measured yet."
        },
        {
          "label": "Where the lines come from",
          "value": "How much his innings matter (closers, high- and low-leverage arms) is read on Pennant's fixed lines, on a scale where 1.0 is an average plate appearance in this league."
        },
        {
          "label": "Where the lines come from",
          "value": "Starting values are the ones Pennant ships with."
        },
        {
          "label": "Where the lines come from",
          "value": "They are replaced by this league's own only after those have been checked against players and seasons they were not drawn from, and, for how players age, how much recent seasons count, what a hitter's tools say and how much a hitter's own split counts, only where this league's own did clearly better than the starting values there."
        },
        {
          "label": "Where the lines come from",
          "value": "What the tools say can only be checked on seasons that came after the ratings were saved, which takes several seasons of imports."
        }
      ],
