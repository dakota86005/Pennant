{
  "glossary": [
    {
      "display": "2B",
      "text": "Doubles"
    },
    {
      "display": "3B",
      "text": "Triples"
    },
    {
      "display": "AB",
      "text": "At bats"
    },
    {
      "display": "Age",
      "text": "The player's age as of this point in the season. OOTP ages players on their real birthday, so a 'Age 27' season may end at 28."
    },
    {
      "display": "App",
      "text": "Appearances in the last three days — today, yesterday, and the day before."
    },
    {
      "display": "Availability tonight",
      "text": "Whether this reliever can realistically be used in the next game, based on his recent pitch counts and consecutive appearances rather than on his season stats."
    },
    {
      "display": "AVG",
      "text": "Batting average — hits per at bat"
    },
    {
      "display": "B",
      "text": "Which side he bats from. L = left, R = right, S = switch hitter."
    },
    {
      "display": "B/T",
      "text": "Bats / Throws. L = left, R = right, S = switch hitter. The batting hand drives the platoon advantage: hitters generally do better against the opposite hand."
    },
    {
      "display": "BABIP",
      "text": "Batting average on balls in play. Far from league average (~.300) often signals luck that will regress."
    },
    {
      "display": "BB",
      "text": "Walks"
    },
    {
      "display": "BB/9",
      "text": "Walks per nine innings"
    },
    {
      "display": "BB%",
      "text": "Walk rate — walks per plate appearance"
    },
    {
      "display": "Control",
      "text": "Command of the strike zone on the 1-100 scale. Low control shows up as walks."
    },
    {
      "display": "CS",
      "text": "Caught stealing"
    },
    {
      "display": "Cur Δ",
      "text": "Change in current ability since the previous import. Positive means he has genuinely improved, not just performed better."
    },
    {
      "display": "Current salary",
      "text": "What the player earned in the most recent season, a rough anchor for what he will ask for next."
    },
    {
      "display": "DIFF",
      "text": "Run differential — runs scored minus runs allowed. Over a full season it predicts future record better than the current record does, so a good team with a bad record usually improves."
    },
    {
      "display": "ER",
      "text": "Earned runs allowed"
    },
    {
      "display": "ERA",
      "text": "Earned run average per nine innings"
    },
    {
      "display": "ERA+",
      "text": "ERA adjusted for league run environment and ballpark, scaled so 100 = league average. 130 means 30% better than average."
    },
    {
      "display": "Est. return",
      "text": "Estimated days until the player is back. OOTP revises this as the injury progresses."
    },
    {
      "display": "FIP",
      "text": "Fielding Independent Pitching — what ERA would be based only on strikeouts, walks, and home runs, with defense and batted-ball luck removed. Scaled to the league ERA."
    },
    {
      "display": "Fit",
      "text": "How well this free agent addresses a hole on your roster, comparing his value to what you currently have at that position."
    },
    {
      "display": "Flags",
      "text": "Quick contract markers — expiring, still under team control, options, and no-trade clauses."
    },
    {
      "display": "G",
      "text": "Games pitched"
    },
    {
      "display": "GB",
      "text": "Games behind the division leader. One game back means winning one more and having the leader lose one would tie it."
    },
    {
      "display": "GS",
      "text": "Games started"
    },
    {
      "display": "H",
      "text": "Hits"
    },
    {
      "display": "Handle Rookies",
      "text": "How well the coach develops young and inexperienced players specifically."
    },
    {
      "display": "HLD",
      "text": "Holds"
    },
    {
      "display": "HR",
      "text": "Home runs"
    },
    {
      "display": "HR/9",
      "text": "Home runs per nine innings"
    },
    {
      "display": "IL days this yr",
      "text": "Days spent on the injured list this season."
    },
    {
      "display": "IP",
      "text": "Innings pitched"
    },
    {
      "display": "ISO",
      "text": "Isolated power (SLG − AVG) — extra-base ability with singles stripped out"
    },
    {
      "display": "Issues",
      "text": "Roster problems needing a decision — out of options, Rule 5 exposure, or a designation clock running."
    },
    {
      "display": "K",
      "text": "Strikeouts"
    },
    {
      "display": "K/9",
      "text": "Strikeouts per nine innings"
    },
    {
      "display": "K/BB",
      "text": "Strikeout-to-walk ratio. Around 3.0 is excellent command."
    },
    {
      "display": "K%",
      "text": "Strikeout rate — strikeouts per plate appearance"
    },
    {
      "display": "L",
      "text": "Losses."
    },
    {
      "display": "Level",
      "text": "The level he is playing at: MLB, AAA, AA, A, or Rookie ball."
    },
    {
      "display": "Lvl",
      "text": "The level the stat line was compiled at. Numbers from different levels are not directly comparable — a .900 OPS in A-ball is a far weaker signal than the same mark in the majors."
    },
    {
      "display": "Manager",
      "text": "The person in the role. Coach ratings feed player development and in-game decisions."
    },
    {
      "display": "Missed",
      "text": "Games missed from this injury."
    },
    {
      "display": "Movement",
      "text": "How much the ball moves, on the 1-100 scale. It mostly suppresses home runs and hard contact."
    },
    {
      "display": "Next start",
      "text": "How many days until this starter is next in line, assuming a normal five-man rotation."
    },
    {
      "display": "Notes",
      "text": "Contract clauses: team, player, and vesting options, plus no-trade protection."
    },
    {
      "display": "OBP",
      "text": "On-base percentage. The single best simple measure of a hitter avoiding outs."
    },
    {
      "display": "Opp",
      "text": "The opposing team in that game."
    },
    {
      "display": "OPS",
      "text": "On-base plus slugging. A quick read of a hitter's whole offense, but unadjusted for league or park."
    },
    {
      "display": "OPS+",
      "text": "OPS adjusted for league run environment and ballpark, scaled so 100 = league average. 130 means 30% better than average."
    },
    {
      "display": "Options used",
      "text": "Option years already burned. A player normally has three; once they are gone he cannot be sent down without clearing waivers first."
    },
    {
      "display": "P/3d",
      "text": "Pitches thrown across the last three days. This is what actually decides whether an arm is available tonight, no matter how good the season line looks."
    },
    {
      "display": "PA",
      "text": "Plate appearances"
    },
    {
      "display": "PCT",
      "text": "Winning percentage: wins divided by games played."
    },
    {
      "display": "Pitcher",
      "text": "Click the name to open the full player card, including his pitch arsenal and velocity."
    },
    {
      "display": "Player",
      "text": "Click any name to open the full player card: ratings, contract, career history, game logs, and injuries."
    },
    {
      "display": "Pos",
      "text": "Primary fielding position, the one OOTP lists him at. Many players are rated at several — open the player card to see every position he can cover."
    },
    {
      "display": "R",
      "text": "Runs scored"
    },
    {
      "display": "RA",
      "text": "Runs allowed across the season so far."
    },
    {
      "display": "RBI",
      "text": "Runs batted in"
    },
    {
      "display": "Rest",
      "text": "Days since this pitcher last appeared in a game."
    },
    {
      "display": "Rk",
      "text": "Rank within this list."
    },
    {
      "display": "RS",
      "text": "Runs scored across the season so far."
    },
    {
      "display": "Salary",
      "text": "What he is paid this season."
    },
    {
      "display": "SB",
      "text": "Stolen bases"
    },
    {
      "display": "SB%",
      "text": "Stolen base success rate. Below ~70% costs more runs than it creates."
    },
    {
      "display": "Shape",
      "text": "The salary curve across the life of the deal. A rising line is a backloaded contract; a falling one is frontloaded. Hard to see in a row of numbers, obvious as a shape."
    },
    {
      "display": "SLG",
      "text": "Slugging percentage — total bases per at bat"
    },
    {
      "display": "Stam",
      "text": "Stamina, on the 1-100 rating scale. It governs how deep a starter can go before tiring and whether a reliever can handle more than one inning."
    },
    {
      "display": "Status",
      "text": "Roster status — active, on an option to the minors, on the injured list, or exposed to waivers."
    },
    {
      "display": "STRK",
      "text": "Current streak. W3 means three straight wins, L2 two straight losses."
    },
    {
      "display": "Stuff",
      "text": "Raw swing-and-miss ability on the 1-100 scale — the rating most associated with strikeouts."
    },
    {
      "display": "SV",
      "text": "Saves"
    },
    {
      "display": "Svc",
      "text": "Major-league service years. Six years of service normally brings free agency, and three brings arbitration — the two dates that shape every contract decision."
    },
    {
      "display": "T",
      "text": "Which hand he throws with."
    },
    {
      "display": "Teach Hitting",
      "text": "The coach's ability to develop hitters, on the 1-100 scale. It compounds over a full season of instruction."
    },
    {
      "display": "Teach Pitching",
      "text": "The coach's ability to develop pitchers, on the 1-100 scale."
    },
    {
      "display": "Team",
      "text": "The club. On roster and search views this is the player’s current team — for minor leaguers that is the affiliate, not the parent club."
    },
    {
      "display": "Through",
      "text": "The final season covered by the contract."
    },
    {
      "display": "Thru",
      "text": "The final season covered by the contract."
    },
    {
      "display": "Type",
      "text": "The kind of injury."
    },
    {
      "display": "Velocity",
      "text": "Fastball velocity. Useful context for Stuff — the same Stuff rating plays differently at 91 mph than at 98."
    },
    {
      "display": "W",
      "text": "Wins."
    },
    {
      "display": "W-L",
      "text": "The pitcher's won-lost record. It depends heavily on run support and bullpen work, so it says more about the team than the pitcher — ERA+ and FIP are far better measures."
    },
    {
      "display": "WAR",
      "text": "Wins Above Replacement, as calculated by OOTP"
    },
    {
      "display": "What changed",
      "text": "Which individual ratings moved, so a change in the overall number can be traced to a cause."
    },
    {
      "display": "WHIP",
      "text": "Walks and hits per inning pitched — baserunners allowed"
    },
    {
      "display": "Why",
      "text": "What drove this ranking."
    },
    {
      "display": "Why here",
      "text": "The reason this player landed in this lineup slot."
    },
    {
      "display": "wOBA",
      "text": "Weighted on-base average. Like OBP, but each way of reaching base is weighted by how many runs it actually produces. Scaled so league average matches league OBP."
    },
    {
      "display": "wRC+",
      "text": "Weighted Runs Created Plus — the most complete rate stat here. Total offense per plate appearance, park- and league-adjusted, where 100 = league average."
    },
    {
      "display": "XBH",
      "text": "Extra-base hits (2B + 3B + HR)"
    },
    {
      "display": "Your notes",
      "text": "Your own scouting notes. They are stored locally and never leave your machine."
    },
    {
      "display": "Yrs left",
      "text": "Seasons still guaranteed after this one. Zero means the deal expires at the end of this season."
    }
  ],
