    {
      "key": "finn",
      "group": "fielding",
      "display": "Inn",
      "text": "Innings played in the field",
      "format": "int",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "po",
      "group": "fielding",
      "display": "PO",
      "text": "Putouts",
      "format": "int",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "a",
      "group": "fielding",
      "display": "A",
      "text": "Assists",
      "format": "int",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "e",
      "group": "fielding",
      "display": "E",
      "text": "Errors",
      "format": "int",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "dp",
      "group": "fielding",
      "display": "DP",
      "text": "Double plays turned",
      "format": "int",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "fpct",
      "group": "fielding",
      "display": "FPCT",
      "text": "Fielding percentage — putouts plus assists over total chances. It says how often a player handled what he reached, and nothing about how much he reached, so a statue with safe hands can lead the league in it.",
      "format": "avg3",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "rf9",
      "group": "fielding",
      "display": "RF/9",
      "text": "Range factor — putouts plus assists per nine innings. It measures how much a fielder is involved, which is the part fielding percentage misses. Compare it only within a position: a first baseman handles far more chances than a left fielder.",
      "format": "dec2",
      "section": "Fielding",
      "lowerIsBetter": false
    },
    {
      "key": "avgExitVelo",
      "group": "contact",
      "display": "EV",
      "text": "Average exit velocity in mph across every batted ball. League average is around 86-87; 92 and up is genuine thump.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "maxExitVelo",
      "group": "contact",
      "display": "Max EV",
      "text": "His hardest-hit ball of the season, in mph. A high peak with a modest average means the power is real but intermittent.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "hardHitPct",
      "group": "contact",
      "display": "Hard%",
      "text": "Share of batted balls struck at 95 mph or more. The most stable contact-quality number there is — it settles long before batting average does.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "barrelPct",
      "group": "contact",
      "display": "Brl%",
      "text": "Share of batted balls hit hard enough, at an angle good enough, to be near-certain damage. The window opens at 98 mph and widens as the ball is hit harder.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "sweetSpotPct",
      "group": "contact",
      "display": "Sweet%",
      "text": "Share of batted balls launched between 8 and 32 degrees, the angles that produce line drives rather than choppers and popups.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "gbPct",
      "group": "contact",
      "display": "GB%",
      "text": "Share of batted balls hit on the ground (under 10 degrees).",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "fbPct",
      "group": "contact",
      "display": "FB%",
      "text": "Share of batted balls hit in the air (25 to 50 degrees).",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "sprintSpeed",
      "group": "contact",
      "display": "Sprint",
      "text": "Measured speed on the bases, averaged across his batted balls — what he actually does, rather than the scouted speed rating.",
      "format": "dec1",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "xslg",
      "group": "contact",
      "display": "xSLG",
      "text": "What his contact usually produces: every batted ball scored by how balls of that speed and angle actually fared at his level this season.",
      "format": "avg3",
      "section": "Contact",
      "lowerIsBetter": false
    },
    {
      "key": "slgLuck",
      "group": "contact",
      "display": "SLG±",
      "text": "Actual slugging on batted balls minus expected. Strongly negative means he has hit the ball well and been robbed; strongly positive means the results have outrun the contact.",
      "format": "avg3",
      "section": "Contact",
      "lowerIsBetter": false
    }
