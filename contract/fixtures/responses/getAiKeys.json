  "where": {
    "text": "Keys are kept in the data folder.",
    "tone": "neutral",
    "basis": {
      "because": [
        {
          "label": "Where",
          "value": "In the data folder, encrypted where the system allows."
        },
        {
          "label": "Where a key goes",
          "value": "Only to its own provider, with the question or the figures being written about. It is never shown in full, logged or sent anywhere else."
        }
      ],
      "source": {
        "department": "frontOffice",
        "specialist": "Settings",
        "asOf": null,
        "gameDate": null
      },
      "unknown": [],
      "wouldChange": [],
      "lean": null,
      "certainty": "recorded",
      "called": "From Pennant's own record"
    },
    "links": []
  },
