  "reenter": {
    "text": "Pennant couldn't read the key saved for this provider. Enter it again.",
    "tone": "caution",
    "basis": {
      "because": [
        {
          "label": "What happened",
          "value": "A key is saved in your Keychain, but this copy of Pennant was not allowed to read it without asking you (it may have been saved by another build)."
        },
        {
          "label": "What to do",
          "value": "Enter the key again and save it. Pennant removes the items it may and keeps the key in a new one of its own; an item another copy saved stays where it is, unused."
        }
      ],
      "source": {
        "department": "frontOffice",
        "specialist": "Settings",
        "asOf": null,
        "gameDate": null
      },
      "unknown": [],
      "wouldChange": [
        "The key entered again."
      ],
      "lean": null,
      "certainty": "recorded",
      "called": "From Pennant's own record"
    },
    "links": [],
    "hint": "Saving it keeps a new copy in your Keychain that Pennant can read"
  },
  "otherCopy": {
    "text": "Another copy of Pennant kept a key for this provider here. This copy doesn't use it.",
    "tone": "neutral",
    "basis": {
      "because": [
        {
          "label": "What is left",
          "value": "An item saved by another copy of Pennant (another build, or one signed differently). This copy may neither read nor remove it, so it stays in your Keychain, unused here."
        },
        {
          "label": "To clear it",
          "value": "Remove it in the copy that saved it, or in Keychain Access."
        }
      ],
      "source": {
        "department": "frontOffice",
        "specialist": "Settings",
        "asOf": null,
        "gameDate": null
      },
      "unknown": [],
      "wouldChange": [
        "A key entered here."
      ],
      "lean": null,
      "certainty": "recorded",
      "called": "From Pennant's own record"
    },
    "links": [],
    "hint": "Enter a key to use one in this copy"
  },
  "newerElsewhere": {
    "text": "Another copy of Pennant saved a newer key for this provider. Enter it again to use it here.",
    "tone": "caution",
    "basis": {
      "because": [
        {
          "label": "What happened",
          "value": "Another copy of Pennant saved a key for this provider after this copy did. This copy may not read that one, so it goes on using its own, which may be older."
        }
      ],
      "source": {
        "department": "frontOffice",
